# Generate each value separately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Use hex for POSTGRES_PASSWORD so no URL escaping is needed.
POSTGRES_PASSWORD=
VAULTS_READINESS_TOKEN=
# Absolute host directory outside this repository, provisioned by tls:init.
VAULTS_TLS_DIR=
VAULTS_ACCESS_MODE=loopback
VAULTS_ENDPOINT_HOST=127.0.0.1
VAULTS_PUBLISH_ADDRESS=127.0.0.1
# Signed license files inside the mounted runtime directory (never the issuer private key).
# Configure these after issuing/installing an installation-bound development license.
VAULTS_LICENSE_FILE=
VAULTS_LICENSE_PUBLIC_KEYS_FILE=
