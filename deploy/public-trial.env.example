# Same-origin HTTPS frontend proxies only the three API paths to this service.
PUBLIC_INTAKE_ORIGIN=https://trial.example.com
PUBLIC_INTAKE_PORT=3101
PUBLIC_INTAKE_KEY_FILE=/srv/127vaults-private/intake-key
PUBLIC_INTAKE_DATA_FILE=/srv/127vaults-private/requests.jsonl
PUBLIC_TRIALS=1
PUBLIC_TRIAL_DATA_DIR=/srv/127vaults-private/trials
PUBLIC_TRIAL_OPERATOR_TOKEN_FILE=/srv/127vaults-private/operator-token
PUBLIC_TRIAL_ISSUER_KEY_FILE=/srv/127vaults-private/issuer.pem
PUBLIC_TRIAL_ISSUER_KEY_ID=trial
PUBLIC_TRIAL_CATALOGUE_FILE=/srv/127vaults-private/catalogue.json
PUBLIC_MOCK_SELFHOST=0
