{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "127Vaults Desktop",
  "version": "0.0.0",
  "identifier": "com.127vaults.desktop.poc",
  "build": {
    "beforeDevCommand": "pnpm vite --host 127.0.0.1",
    "beforeBuildCommand": "pnpm vite build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "127Vaults Desktop",
      "width": 1180,
      "height": 760,
      "minWidth": 800,
      "minHeight": 560,
      "resizable": true,
      "center": true,
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self'",
      "capabilities": [
              {
                "identifier": "main-capability",
                "description": "Allow opening web links and essential core features",
                "windows": ["*"],
                "permissions": [
                  "core:default",
                  "core:window:allow-destroy",
                  "opener:default"
                ]
              }
            ]
    }
  },
  "bundle": {
    "active": false,
    "publisher": "127Vaults",
    "shortDescription": "127Vaults encrypted offline vault client",
    "longDescription": "Experimental 127Vaults desktop client for private testing.",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
