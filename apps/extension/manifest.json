{
  "manifest_version": 3,
  "name": "127Vaults (experimental)",
  "version": "0.1.0",
  "description": "Fill a selected login from an unlocked web, desktop, or CLI vault source.",
  "icons": { "16": "src/icons/icon-16.png", "32": "src/icons/icon-32.png", "48": "src/icons/icon-48.png", "128": "src/icons/icon-128.png" },
  "action": { "default_title": "127Vaults", "default_popup": "popup.html", "default_icon": { "16": "src/icons/icon-16.png", "24": "src/icons/icon-24.png", "32": "src/icons/icon-32.png" } },
  "permissions": ["activeTab", "idle", "nativeMessaging", "scripting", "storage"],
  "background": { "service_worker": "src/background.mjs", "type": "module" },
  "optional_host_permissions": ["https://*/*"]
}
